[17.53, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mConfigure default SSE-KMS on the bucket:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_server_side_encryption_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    rule \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[17.64, "o", "      \u001b[2m      apply_server_side_encryption_by_default \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m        sse_algorithm     = \u001b[0m\u001b[2;32m\"aws:kms\"\u001b[0m\n      \u001b[2m        kms_master_key_id = aws_kms_key.s3.arn\u001b[0m\n      \u001b[2m      \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[17.75, "o", "\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_18\u001b[0m: Ensure the S3 bucket has access logging enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n"]
[17.86, "o", "\n    \u001b[3mWithout S3 server access logging there is no record of who read or wrote objects, so a data-access incident cannot be detected, scoped, or investigated. NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires the ability to handle and analyse incidents.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mSend access logs to a dedicated logging bucket:\u001b[0m\n"]
[17.97, "o", "      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_logging\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket        = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    target_bucket = aws_s3_bucket.logs.id\u001b[0m\n      \u001b[2m    target_prefix = \u001b[0m\u001b[2;32m\"s3-access/\"\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n"]
[18.08, "o", "  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_21\u001b[0m: Ensure all data stored in the S3 bucket have versioning enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n"]
[18.19, "o", "    \u001b[3mWithout versioning, an accidental or malicious overwrite/delete is unrecoverable. Versioning provides point-in-time restore, supporting the recovery obligation in GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and business continuity under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable bucket versioning:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_versioning\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[18.3, "o", "      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    versioning_configuration \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m status = \u001b[0m\u001b[2;32m\"Enabled\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_61\u001b[0m: Ensure that an S3 bucket has a lifecycle configuration\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n"]
[18.41, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout lifecycle rules, log and backup objects accumulate indefinitely or are manually purged ad hoc, so retention for data protection and continuity purposes is unmanaged. Lifecycle configuration is the disciplined data lifecycle NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m backup management expects.\u001b[0m\n\n"]
[18.52, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mDefine lifecycle rules \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mtransition + expiry\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m for the bucket:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_lifecycle_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"logs\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.logs.id\u001b[0m\n      \u001b[2m    rule \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[18.63, "o", "      \u001b[2m      id     = \u001b[0m\u001b[2;32m\"expire-logs\"\u001b[0m\n      \u001b[2m      status = \u001b[0m\u001b[2;32m\"Enabled\"\u001b[0m\n      \u001b[2m      expiration \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m days = \u001b[0m\u001b[1;2;36m365\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n"]
[18.74, "o", "  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_62\u001b[0m: Ensure S3 buckets should have event notifications enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n"]
[18.85, "o", "    \u001b[3mWithout event notifications, writes to a bucket holding personal data raise no signal — unexpected mass downloads or deletions go unnoticed instead of feeding the detection capability NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mSubscribe at least one notification target to bucket events:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_notification\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"data\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[18.96, "o", "      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    lambda_function \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m lambda_function_arn = aws_lambda_function.auditor.arn\u001b[0m\n      \u001b[2m                      events = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"s3:ObjectCreated:*\"\u001b[0m\u001b[1;2m]\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_61\u001b[0m: Ensure that an S3 bucket has a lifecycle configuration\n"]
[19.07, "o", "    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout lifecycle rules, log and backup objects accumulate indefinitely or are manually purged ad hoc, so retention for data protection and continuity purposes is unmanaged. Lifecycle configuration is the disciplined data lifecycle NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m backup management expects.\u001b[0m\n"]
[19.18, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mDefine lifecycle rules \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mtransition + expiry\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m for the bucket:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_lifecycle_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"logs\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.logs.id\u001b[0m\n"]
[19.29, "o", "      \u001b[2m    rule \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m      id     = \u001b[0m\u001b[2;32m\"expire-logs\"\u001b[0m\n      \u001b[2m      status = \u001b[0m\u001b[2;32m\"Enabled\"\u001b[0m\n      \u001b[2m      expiration \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m days = \u001b[0m\u001b[1;2;36m365\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[19.4, "o", "\n  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_62\u001b[0m: Ensure S3 buckets should have event notifications enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n"]
[19.51, "o", "\n    \u001b[3mWithout event notifications, writes to a bucket holding personal data raise no signal — unexpected mass downloads or deletions go unnoticed instead of feeding the detection capability NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mSubscribe at least one notification target to bucket events:\u001b[0m\n"]
[19.62, "o", "      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_notification\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"data\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    lambda_function \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m lambda_function_arn = aws_lambda_function.auditor.arn\u001b[0m\n      \u001b[2m                      events = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"s3:ObjectCreated:*\"\u001b[0m\u001b[1;2m]\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n"]
[19.69, "o", "\u001b[1m═══════════════════════════════════════════════════\u001b[0m\n\n"]
