[3.465, "o", "\n\u001b[1m═══════════════════════════════════════════════════\u001b[0m\n\u001b[1m  tf-eu-guard: EU Compliance Scan Report\u001b[0m\n\u001b[1m═══════════════════════════════════════════════════\u001b[0m\n\n\u001b[1mTotal Findings:\u001b[0m \u001b[1;36m52\u001b[0m\n"]
[3.575, "o", "  \u001b[31m●\u001b[0m CRITICAL: \u001b[1;36m6\u001b[0m\n  \u001b[31m●\u001b[0m HIGH: \u001b[1;36m17\u001b[0m\n  \u001b[33m●\u001b[0m MEDIUM: \u001b[1;36m21\u001b[0m\n  \u001b[34m●\u001b[0m LOW: \u001b[1;36m8\u001b[0m\n\n\n"]
[3.685, "o", "\u001b[1;36mFile: \u001b[0m\u001b[1;36m/\u001b[0m\u001b[1;36miam.tf\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_287\u001b[0m: Ensure IAM policies does not allow credentials exposure\n    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n"]
[3.795, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mPolicies that permit credential-generation actions \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3msts:GetFederationToken, iam:CreateAccessKey, \u001b[0m\n\u001b[3mec2:GetPasswordData, etc.\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m let an attacker mint new credentials and pivot, undermining the confidentiality \u001b[0m\n\u001b[3mcontrols GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires and the access control NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m mandates.\u001b[0m\n\n"]
[3.905, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mRemove credential-exposing actions and scope to least privilege:\u001b[0m\n      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"sts:*\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"iam:CreateAccessKey\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  # After:\u001b[0m\n"]
[4.015, "o", "      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"s3:GetObject\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"s3:PutObject\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:s3:::my-app-data/*\"\u001b[0m\n\n    \u001b]8;id=13430247;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/bc-aws-287\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_288\u001b[0m: Ensure IAM policies does not allow data exfiltration\n"]
[4.125, "o", "    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mBroad read actions on all resources \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3ms3:GetObject, secretsmanager:GetSecretValue, \u001b[0m\n"]
[4.235, "o", "\u001b[3mrds:DownloadDBLogFilePortion on \u001b[0m\u001b[3;32m\"*\"\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m enable bulk exfiltration of data, which for personal data is a reportable\u001b[0m\n\u001b[3mbreach under GDPR and a direct failure of the access control expected by NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mConstrain read actions to specific resource ARNs, never \u001b[0m\u001b[2;32m\"*\"\u001b[0m\u001b[2m:\u001b[0m\n"]
[4.345, "o", "      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"s3:GetObject\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:s3:::approved-bucket/*\"\u001b[0m\n\n    \u001b]8;id=13430250;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/bc-aws-288\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_289\u001b[0m: Ensure IAM policies does not allow permissions management \u001b[35m/\u001b[0m resource exposure without \n"]
[4.455, "o", "constraints\n    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n"]
[4.565, "o", "    \u001b[3mPermissions-management actions \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3miam:PutUserPolicy, iam:AttachUserPolicy, s3:PutBucketPolicy, etc.\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m on \u001b[0m\n\u001b[3munconstrained resources let a principal rewrite who can access what, collapsing access control \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mNIS2 Art. \u001b[0m\n\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and putting the confidentiality of all data at risk \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[4.675, "o", "      \u001b[2mRemove permissions-management actions from workload policies, or bound them\u001b[0m\n      \u001b[2mwith a permissions boundary and explicit resource ARNs:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"iam:AttachUserPolicy\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:iam::123456789012:user/app-*\"\u001b[0m\n\n    \u001b]8;id=13430253;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/bc-aws-289\u001b\\→ Documentation\u001b]8;;\u001b\\\n"]
[4.785, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_289\u001b[0m: Ensure IAM policies does not allow permissions management \u001b[35m/\u001b[0m resource exposure without \nconstraints\n    \u001b[2mResource:\u001b[0m aws_iam_role_policy.app_role_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m53\u001b[0m-\u001b[1;36m67\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n"]
[4.895, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mPermissions-management actions \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3miam:PutUserPolicy, iam:AttachUserPolicy, s3:PutBucketPolicy, etc.\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m on \u001b[0m\n\u001b[3munconstrained resources let a principal rewrite who can access what, collapsing access control \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mNIS2 Art. \u001b[0m\n\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and putting the confidentiality of all data at risk \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n"]
[5.005, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mRemove permissions-management actions from workload policies, or bound them\u001b[0m\n      \u001b[2mwith a permissions boundary and explicit resource ARNs:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"iam:AttachUserPolicy\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:iam::123456789012:user/app-*\"\u001b[0m\n"]
[5.115, "o", "\n    \u001b]8;id=13430255;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/bc-aws-289\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_273\u001b[0m: Ensure access is controlled through SSO and not AWS IAM defined users\n    \u001b[2mResource:\u001b[0m aws_iam_user.app_user\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m8\u001b[0m\n"]
[5.225, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mLong-lived IAM users bypass centralized identity management and SSO, making it difficult to enforce MFA, \u001b[0m\n\u001b[3maudit access centrally, and revoke credentials quickly during an incident. NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires \u001b[0m\n\u001b[3meffective access control policies.\u001b[0m\n"]
[5.335, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mDelete standing IAM users and federate access through AWS IAM Identity Center \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mSSO\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  # Remove:\u001b[0m\n      \u001b[2m  # resource \u001b[0m\u001b[2;32m\"aws_iam_user\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"admin\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m \u001b[0m\u001b[2;33m...\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[5.445, "o", "      \u001b[2m  # Use Identity Center permission sets + account assignments instead\u001b[0m\n      \u001b[2m  # \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mmanaged via aws_ssoadmin_* resources or the Identity Center console\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m.\u001b[0m\n\n    \u001b]8;id=13430258;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/bc-aws-273\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_355\u001b[0m: Ensure no IAM policies documents allow \u001b[32m\"*\"\u001b[0m as a statement's resource for restrictable actions\n"]
[5.555, "o", "    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mUsing Resource \u001b[0m\u001b[3;32m\"*\"\u001b[0m\u001b[3m for actions that support resource-level scoping lets the policy reach every object in \u001b[0m\n"]
[5.665, "o", "\u001b[3mthe account, not just those the workload owns. This over-broad reach undermines the access segregation NIS2 \u001b[0m\n\u001b[3mArt. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m expects and the data confidentiality GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mConstrain each statement to specific resource ARNs:\u001b[0m\n"]
[5.775, "o", "      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"*\"\u001b[0m\n      \u001b[2m  # After:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:s3:::my-app-data/*\"\u001b[0m\n\n    \u001b]8;id=13430261;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/bc-aws-355\u001b\\→ Documentation\u001b]8;;\u001b\\\n"]
[5.885, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_290\u001b[0m: Ensure IAM policies does not allow write access without constraints\n    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n"]
[5.995, "o", "\n    \u001b[3mWrite actions \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mCreate/Put/Update/Delete\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m allowed on Resource \u001b[0m\u001b[3;32m\"*\"\u001b[0m\u001b[3m let a principal modify or destroy any \u001b[0m\n\u001b[3mresource in the account, threatening the integrity and availability of personal data \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and \u001b[0m\n\u001b[3mbreaking the least-privilege access control of NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n"]
[6.105, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mScope write actions to the specific resources the workload manages:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"dynamodb:PutItem\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"dynamodb:UpdateItem\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:dynamodb:eu-west-1:123456789012:table/app-*\"\u001b[0m\n\n    \u001b]8;id=13430264;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/bc-aws-290\u001b\\→ Documentation\u001b]8;;\u001b\\\n"]
[6.215, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_355\u001b[0m: Ensure no IAM policies documents allow \u001b[32m\"*\"\u001b[0m as a statement's resource for restrictable actions\n    \u001b[2mResource:\u001b[0m aws_iam_role_policy.app_role_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m53\u001b[0m-\u001b[1;36m67\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n"]
[6.325, "o", "\n    \u001b[3mUsing Resource \u001b[0m\u001b[3;32m\"*\"\u001b[0m\u001b[3m for actions that support resource-level scoping lets the policy reach every object in \u001b[0m\n\u001b[3mthe account, not just those the workload owns. This over-broad reach undermines the access segregation NIS2 \u001b[0m\n\u001b[3mArt. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m expects and the data confidentiality GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires.\u001b[0m\n\n\n"]
[6.435, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mConstrain each statement to specific resource ARNs:\u001b[0m\n      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"*\"\u001b[0m\n      \u001b[2m  # After:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:s3:::my-app-data/*\"\u001b[0m\n"]
[6.545, "o", "\n    \u001b]8;id=13430266;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/bc-aws-355\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_290\u001b[0m: Ensure IAM policies does not allow write access without constraints\n    \u001b[2mResource:\u001b[0m aws_iam_role_policy.app_role_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m53\u001b[0m-\u001b[1;36m67\u001b[0m\n"]
[6.655, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWrite actions \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mCreate/Put/Update/Delete\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m allowed on Resource \u001b[0m\u001b[3;32m\"*\"\u001b[0m\u001b[3m let a principal modify or destroy any \u001b[0m\n\u001b[3mresource in the account, threatening the integrity and availability of personal data \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and \u001b[0m\n\u001b[3mbreaking the least-privilege access control of NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n"]
[6.765, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mScope write actions to the specific resources the workload manages:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"dynamodb:PutItem\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"dynamodb:UpdateItem\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:dynamodb:eu-west-1:123456789012:table/app-*\"\u001b[0m\n"]
[6.875, "o", "\n    \u001b]8;id=13430268;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/bc-aws-290\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_40\u001b[0m: Ensure IAM policies are attached only to groups or roles \u001b[1m(\u001b[0mReducing access management \ncomplexity may in-turn reduce opportunity for a principal to inadvertently receive or retain excessive \nprivileges.\u001b[1m)\u001b[0m\n"]
[6.985, "o", "    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mAttaching policies directly to individual IAM users makes entitlements hard to review and revoke at scale,\u001b[0m\n"]
[7.095, "o", "\u001b[3mweakening the asset- and access-management discipline NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m expects. Group/role attachment keeps \u001b[0m\n\u001b[3mprivileges auditable.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mAttach the policy to a group or role and add the user to the group:\u001b[0m\n"]
[7.205, "o", "      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_iam_group_policy_attachment\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"app\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    group      = aws_iam_group.app.name\u001b[0m\n      \u001b[2m    policy_arn = aws_iam_policy.app.arn\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430271;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/iam-16-iam-policy-privileges-1\u001b\\→ Documentation\u001b]8;;\u001b\\\n"]
[7.315, "o", "\n\u001b[1;36mFile: \u001b[0m\u001b[1;36m/\u001b[0m\u001b[1;36mmain.tf\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mEUGUARD_GDPR_001\u001b[0m: Ensure the AWS provider region is in the EU \u001b[1m(\u001b[0mGDPR data residency, Art. \u001b[1;36m44\u001b[0m-\u001b[1;36m49\u001b[0m\u001b[1m)\u001b[0m\n    \u001b[2mResource:\u001b[0m aws.default\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m13\u001b[0m\n"]
[7.425, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;36m44\u001b[0m\n\n    \u001b[3mDeploying resources through an AWS provider pinned to a non-EU region stores personal data outside the \u001b[0m\n\u001b[3mEU/EEA - a transfer to a third country. GDPR Chapter V \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mArt. \u001b[0m\u001b[1;3;36m44\u001b[0m\u001b[3m-\u001b[0m\u001b[1;3;36m49\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m permits this only under specific \u001b[0m\n\u001b[3msafeguards \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3man adequacy decision, Standard Contractual Clauses, or Binding Corporate Rules\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m; an unqualified \u001b[0m\n"]
[7.535, "o", "\u001b[3mnon-EU region is a data-residency violation that must be justified under one of those mechanisms or corrected.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mPin every aws provider block to an EU region, or gate a non-EU provider\u001b[0m\n      \u001b[2mbehind a documented Chapter V transfer mechanism:\u001b[0m\n"]
[7.645, "o", "      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  provider \u001b[0m\u001b[2;32m\"aws\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m region = \u001b[0m\u001b[2;32m\"us-east-1\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  # After:\u001b[0m\n      \u001b[2m  provider \u001b[0m\u001b[2;32m\"aws\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m region = \u001b[0m\u001b[2;32m\"eu-west-1\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n\n\u001b[1;36mFile: \u001b[0m\u001b[1;36m/\u001b[0m\u001b[1;36mnetwork.tf\u001b[0m\n"]
[7.755, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_24\u001b[0m: Ensure no security groups allow ingress from \u001b[1;92m0.0.0.0\u001b[0m:\u001b[1;36m0\u001b[0m to port \u001b[1;36m22\u001b[0m\n    \u001b[2mResource:\u001b[0m aws_security_group.web\n    \u001b[2mLines:\u001b[0m \u001b[1;36m61\u001b[0m-\u001b[1;36m93\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n"]
[7.865, "o", "\n    \u001b[3mSSH \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mport \u001b[0m\u001b[1;3;36m22\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m open to \u001b[0m\u001b[1;3;92m0.0.0.0\u001b[0m\u001b[3m/\u001b[0m\u001b[1;3;36m0\u001b[0m\u001b[3m exposes administrative shell access to the entire internet, inviting \u001b[0m\n\u001b[3mbrute-force and exploitation of any host that may process personal data. This is a failure of network access \u001b[0m\n\u001b[3mcontrol \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mNIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and of the confidentiality safeguards GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires.\u001b[0m\n\n\n"]
[7.975, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mRestrict SSH to a bastion or corporate CIDR, never the internet:\u001b[0m\n      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"0.0.0.0/0\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  # After:\u001b[0m\n      \u001b[2m  cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"10.0.0.0/8\"\u001b[0m\u001b[1;2m]\u001b[0m\u001b[2m   # or a specific admin range \u001b[0m\u001b[2;35m/\u001b[0m\u001b[2m use SSM Session Manager\u001b[0m\n"]
[8.085, "o", "\n    \u001b]8;id=13430274;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/networking-1-port-security\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_130\u001b[0m: Ensure VPC subnets do not assign public IP by default\n    \u001b[2mResource:\u001b[0m aws_subnet.public_a\n    \u001b[2mLines:\u001b[0m \u001b[1;36m14\u001b[0m-\u001b[1;36m24\u001b[0m\n"]
[8.195, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mSubnets that auto-assign public IPs place workloads directly on the internet by default, widening the \u001b[0m\n\u001b[3mattack surface for systems that may process personal data - a confidentiality risk \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and \u001b[0m\n\u001b[3mweak network segmentation under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n"]
[8.305, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mDisable automatic public IP assignment; use NAT for egress:\u001b[0m\n      \u001b[2m  map_public_ip_on_launch = false\u001b[0m\n\n"]
[8.415, "o", "    \u001b]8;id=13430277;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/ensure-vpc-subnets-do-not-assign-public-ip-by-default\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_130\u001b[0m: Ensure VPC subnets do not assign public IP by default\n    \u001b[2mResource:\u001b[0m aws_subnet.public_b\n    \u001b[2mLines:\u001b[0m \u001b[1;36m26\u001b[0m-\u001b[1;36m36\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n"]
[8.525, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mSubnets that auto-assign public IPs place workloads directly on the internet by default, widening the \u001b[0m\n\u001b[3mattack surface for systems that may process personal data - a confidentiality risk \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and \u001b[0m\n\u001b[3mweak network segmentation under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n"]
[8.635, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mDisable automatic public IP assignment; use NAT for egress:\u001b[0m\n      \u001b[2m  map_public_ip_on_launch = false\u001b[0m\n\n    \u001b]8;id=13430279;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/ensure-vpc-subnets-do-not-assign-public-ip-by-default\u001b\\→ Documentation\u001b]8;;\u001b\\\n"]
[8.745, "o", "\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_260\u001b[0m: Ensure no security groups allow ingress from \u001b[1;92m0.0.0.0\u001b[0m:\u001b[1;36m0\u001b[0m to port \u001b[1;36m80\u001b[0m\n    \u001b[2mResource:\u001b[0m aws_security_group.web\n    \u001b[2mLines:\u001b[0m \u001b[1;36m61\u001b[0m-\u001b[1;36m93\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[8.855, "o", "\n    \u001b[3mPlain-HTTP \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mport \u001b[0m\u001b[1;3;36m80\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m open to the world serves traffic unencrypted and widens the attack surface. Where it \u001b[0m\n\u001b[3mfronts systems processing personal data it weakens the network access control expected by NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m; \u001b[0m\n\u001b[3mtraffic should terminate TLS at a load balancer instead.\u001b[0m\n\n\n"]
[8.965, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mFront the service with HTTPS and restrict or redirect port \u001b[0m\u001b[1;2;36m80\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  # Terminate TLS \u001b[0m\u001b[1;2m(\u001b[0m\u001b[1;2;36m443\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m at an ALB and redirect \u001b[0m\u001b[1;2;36m80\u001b[0m\u001b[2m -> \u001b[0m\u001b[1;2;36m443\u001b[0m\u001b[2m, or scope the CIDR:\u001b[0m\n      \u001b[2m  cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"10.0.0.0/8\"\u001b[0m\u001b[1;2m]\u001b[0m\n\n    \u001b]8;id=13430282;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/ensure-aws-security-groups-do-not-allow-ingress-from-00000-to-port-80\u001b\\→ Documentation\u001b]8;;\u001b\\\n"]
[9.075, "o", "\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_382\u001b[0m: Ensure no security groups allow egress from \u001b[1;92m0.0.0.0\u001b[0m:\u001b[1;36m0\u001b[0m to port \u001b[1;36m-1\u001b[0m\n    \u001b[2mResource:\u001b[0m aws_security_group.web\n    \u001b[2mLines:\u001b[0m \u001b[1;36m61\u001b[0m-\u001b[1;36m93\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[9.185, "o", "\n    \u001b[3mUnrestricted egress \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mall ports/protocols to \u001b[0m\u001b[1;3;92m0.0.0.0\u001b[0m\u001b[3m/\u001b[0m\u001b[1;3;36m0\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m gives a compromised host a clear path to exfiltrate\u001b[0m\n\u001b[3mdata or reach command-and-control infrastructure. Egress filtering is part of the network segmentation and \u001b[0m\n\u001b[3maccess control under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n"]
[9.295, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mScope egress to the destinations and ports the workload actually needs:\u001b[0m\n      \u001b[2m  egress \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    from_port   = \u001b[0m\u001b[1;2;36m443\u001b[0m\n      \u001b[2m    to_port     = \u001b[0m\u001b[1;2;36m443\u001b[0m\n      \u001b[2m    protocol    = \u001b[0m\u001b[2;32m\"tcp\"\u001b[0m\n"]
[9.405, "o", "      \u001b[2m    cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"10.0.0.0/8\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430285;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/bc-aws-382\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_382\u001b[0m: Ensure no security groups allow egress from \u001b[1;92m0.0.0.0\u001b[0m:\u001b[1;36m0\u001b[0m to port \u001b[1;36m-1\u001b[0m\n"]
[9.515, "o", "    \u001b[2mResource:\u001b[0m aws_security_group.rds\n    \u001b[2mLines:\u001b[0m \u001b[1;36m96\u001b[0m-\u001b[1;36m119\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mUnrestricted egress \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mall ports/protocols to \u001b[0m\u001b[1;3;92m0.0.0.0\u001b[0m\u001b[3m/\u001b[0m\u001b[1;3;36m0\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m gives a compromised host a clear path to exfiltrate\u001b[0m\n"]
[9.625, "o", "\u001b[3mdata or reach command-and-control infrastructure. Egress filtering is part of the network segmentation and \u001b[0m\n\u001b[3maccess control under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mScope egress to the destinations and ports the workload actually needs:\u001b[0m\n"]
[9.735, "o", "      \u001b[2m  egress \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    from_port   = \u001b[0m\u001b[1;2;36m443\u001b[0m\n      \u001b[2m    to_port     = \u001b[0m\u001b[1;2;36m443\u001b[0m\n      \u001b[2m    protocol    = \u001b[0m\u001b[2;32m\"tcp\"\u001b[0m\n      \u001b[2m    cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"10.0.0.0/8\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[9.845, "o", "\n    \u001b]8;id=13430287;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/bc-aws-382\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV2_AWS_11\u001b[0m: Ensure VPC flow logging is enabled in all VPCs\n    \u001b[2mResource:\u001b[0m aws_vpc.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m11\u001b[0m\n"]
[9.955, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout VPC flow logs there is no network-level record of accepted/rejected connections, so lateral \u001b[0m\n\u001b[3mmovement and exfiltration attempts cannot be detected or reconstructed. NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires detection \u001b[0m\n\u001b[3mand analysis of incidents.\u001b[0m\n"]
[10.065, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable flow logs for the VPC:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_flow_log\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    vpc_id          = aws_vpc.main.id\u001b[0m\n"]
[10.175, "o", "      \u001b[2m    traffic_type    = \u001b[0m\u001b[2;32m\"ALL\"\u001b[0m\n      \u001b[2m    log_destination = aws_cloudwatch_log_group.vpc_flow.arn\u001b[0m\n      \u001b[2m    iam_role_arn    = aws_iam_role.vpc_flow.arn\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430290;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-logging-policies/logging-9-enable-vpc-flow-logging\u001b\\→ Documentation\u001b]8;;\u001b\\\n"]
[10.285, "o", "\n  \u001b[33m●\u001b[0m \u001b[1mCKV2_AWS_12\u001b[0m: Ensure the default security group of every VPC restricts all traffic\n    \u001b[2mResource:\u001b[0m aws_vpc.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m11\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[10.395, "o", "\n    \u001b[3mAn unmanaged default security group can implicitly allow traffic between any resources that fall back to \u001b[0m\n\u001b[3mit, bypassing intended segmentation. NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m expects deliberate, least-privilege network access \u001b[0m\n\u001b[3mcontrol.\u001b[0m\n\n\n"]
[10.505, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mManage the default SG and strip all ingress/egress:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_default_security_group\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"default\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    vpc_id = aws_vpc.main.id\u001b[0m\n      \u001b[2m    # no ingress or egress blocks = deny all\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[10.615, "o", "\n    \u001b]8;id=13430293;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/networking-4\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[34m●\u001b[0m \u001b[1mCKV_AWS_23\u001b[0m: Ensure every security group and rule has a description\n    \u001b[2mResource:\u001b[0m aws_security_group.rds\n    \u001b[2mLines:\u001b[0m \u001b[1;36m96\u001b[0m-\u001b[1;36m119\u001b[0m\n"]
[10.725, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mUndocumented rules cannot be reviewed: nobody can tell which rule is a deliberate control and which is \u001b[0m\n\u001b[3mleftover access. Descriptions are what make rule review — and therefore accountable access control under NIS2 \u001b[0m\n\u001b[3mArt. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m — possible.\u001b[0m\n"]
[10.835, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mDescribe the purpose of every group and rule:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_security_group\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"web\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    description = \u001b[0m\u001b[2;32m\"Web tier: HTTP from office CIDR only\"\u001b[0m\n"]
[10.945, "o", "      \u001b[2m    ingress \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m      description = \u001b[0m\u001b[2;32m\"HTTP from office\"\u001b[0m\n      \u001b[2m      cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"203.0.113.0/24\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n"]
[11.055, "o", "    \u001b]8;id=13430296;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/networking-31\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_5\u001b[0m: Ensure that Security Groups are attached to another resource\n    \u001b[2mResource:\u001b[0m aws_security_group.web\n    \u001b[2mLines:\u001b[0m \u001b[1;36m61\u001b[0m-\u001b[1;36m93\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n"]
[11.165, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mOrphaned security groups accumulate stale rules that later get attached \u001b[0m\u001b[3;32m\"because they were there\"\u001b[0m\u001b[3m, \u001b[0m\n\u001b[3mimporting unintended access into live environments — an unmanaged asset under the access control and asset \u001b[0m\n\u001b[3mmanagement of NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n"]
[11.275, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mReference every security group from the resource it guards \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mand delete the rest\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"app\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    vpc_security_group_ids = \u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[11.385, "o", "\n    \u001b]8;id=13430299;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/ensure-that-security-groups-are-attached-to-ec2-instances-or-elastic-network-interfaces-enis\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n\u001b[1;36mFile: \u001b[0m\u001b[1;36m/\u001b[0m\u001b[1;36mrds.tf\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_17\u001b[0m: Ensure all data stored in RDS is not publicly accessible\n"]
[11.495, "o", "    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mA publicly accessible database is reachable from the internet, exposing personal data to \u001b[0m\n"]
[11.605, "o", "\u001b[3mcredential-stuffing and exploitation. This is a confidentiality failure under GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and an access\u001b[0m\n\u001b[3mcontrol failure under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mKeep the instance private and reach it only from within the VPC:\u001b[0m\n"]
[11.715, "o", "      \u001b[2m  publicly_accessible = false\u001b[0m\n      \u001b[2m  # place the instance in private subnets via a db_subnet_group and\u001b[0m\n      \u001b[2m  # restrict the security group to internal CIDRs only.\u001b[0m\n\n    \u001b]8;id=13430302;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/public-policies/public-2\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n"]
[11.825, "o", "  \u001b[31m●\u001b[0m \u001b[1mEUGUARD_NIS2_001\u001b[0m: Ensure secrets are not hardcoded in Terraform \u001b[1m(\u001b[0muse variables/Secrets Manager\u001b[1m)\u001b[0m\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0me\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n"]
[11.935, "o", "    \u001b[3mA literal credential \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mdatabase password, auth token, private key\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m committed to Terraform is readable by \u001b[0m\n\u001b[3manyone with repository or state access, cannot be rotated centrally, and frequently leaks through CI logs. \u001b[0m\n\u001b[3mStoring secrets in code is an insecure-development practice under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3me\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and, where the secret \u001b[0m\n\u001b[3mprotects personal data, a confidentiality risk under GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n"]
[12.045, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mNever inline secrets. Source them from a secrets manager or a sensitive\u001b[0m\n      \u001b[2mvariable injected at apply time:\u001b[0m\n      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  password = \u001b[0m\u001b[2;32m\"ChangeMe123!\"\u001b[0m\n      \u001b[2m  # After:\u001b[0m\n"]
[12.155, "o", "      \u001b[2m  password = data.aws_secretsmanager_secret_version.db.secret_string\u001b[0m\n      \u001b[2m  # or a variable marked `sensitive` and sourced from the environment/a vault.\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_16\u001b[0m: Ensure all data stored in the RDS is securely encrypted at rest\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n"]
[12.265, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mh\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0ma\u001b[1m)\u001b[0m\n\n    \u001b[3mAn unencrypted RDS instance leaves personal data readable on the underlying storage and in snapshots. GDPR\u001b[0m\n\u001b[3mArt. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3ma\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m names encryption explicitly and NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mh\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires cryptography controls for data at \u001b[0m\n\u001b[3mrest.\u001b[0m\n"]
[12.375, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable storage encryption \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mimmutable - requires recreate/restore\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    storage_encrypted = true\u001b[0m\n"]
[12.485, "o", "      \u001b[2m    kms_key_id        = aws_kms_key.rds.arn\u001b[0m\n      \u001b[2m    # \u001b[0m\u001b[2;33m...\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430305;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/general-4\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n"]
[12.595, "o", "  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_133\u001b[0m: Ensure that RDS instances has backup policy\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n"]
[12.705, "o", "    \u001b[3mA zero-day backup retention means no point-in-time recovery: hardware failure, corruption, or ransomware \u001b[0m\n\u001b[3mresults in permanent data loss. Both NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m require the ability to restore \u001b[0m\n\u001b[3mavailability of data.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[12.815, "o", "      \u001b[2mSet a non-zero backup retention window \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2m>= \u001b[0m\u001b[1;2;36m7\u001b[0m\u001b[2m days recommended\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  backup_retention_period = \u001b[0m\u001b[1;2;36m7\u001b[0m\n      \u001b[2m  backup_window           = \u001b[0m\u001b[2;32m\"03:00-04:00\"\u001b[0m\n\n    \u001b]8;id=13430308;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-that-rds-instances-have-backup-policy\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n"]
[12.925, "o", "  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_293\u001b[0m: Ensure that AWS database instances have deletion protection enabled\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n"]
[13.035, "o", "    \u001b[3mWithout deletion protection, a mistaken or malicious destroy removes the database and its data with no \u001b[0m\n\u001b[3mconfirmation barrier, threatening the availability that both NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m \u001b[0m\n\u001b[3mrequire.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[13.145, "o", "      \u001b[2mEnable deletion protection on the instance:\u001b[0m\n      \u001b[2m  deletion_protection = true\u001b[0m\n\n    \u001b]8;id=13430311;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/bc-aws-293\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_118\u001b[0m: Ensure that enhanced monitoring is enabled for Amazon RDS instances\n"]
[13.255, "o", "    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout enhanced monitoring, OS-level metrics \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mCPU, memory, process and I/O activity\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m are unavailable, so \u001b[0m\n"]
[13.365, "o", "\u001b[3mresource-exhaustion attacks or anomalous database host behaviour cannot be detected or investigated - contrary\u001b[0m\n\u001b[3mto the incident detection and handling required by NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable enhanced monitoring with a monitoring role and a non-zero interval:\u001b[0m\n"]
[13.475, "o", "      \u001b[2m  monitoring_interval = \u001b[0m\u001b[1;2;36m60\u001b[0m\n      \u001b[2m  monitoring_role_arn = aws_iam_role.rds_monitoring.arn\u001b[0m\n\n    \u001b]8;id=13430314;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-logging-policies/ensure-that-enhanced-monitoring-is-enabled-for-amazon-rds-instances\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_129\u001b[0m: Ensure that respective logs of Amazon Relational Database Service \u001b[1m(\u001b[0mAmazon RDS\u001b[1m)\u001b[0m are enabled\n"]
[13.585, "o", "    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout database engine logs exported to CloudWatch, suspicious queries and authentication failures leave \u001b[0m\n"]
[13.695, "o", "\u001b[3mno trail, so a data-access incident cannot be detected or investigated - contrary to NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mExport the relevant engine logs:\u001b[0m\n      \u001b[2m  enabled_cloudwatch_logs_exports = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"postgresql\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"upgrade\"\u001b[0m\u001b[1;2m]\u001b[0m\n"]
[13.805, "o", "      \u001b[2m  # \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mfor MySQL: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"audit\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"error\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"general\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"slowquery\"\u001b[0m\u001b[1;2m]\u001b[0m\u001b[1;2m)\u001b[0m\n\n    \u001b]8;id=13430317;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/ensure-that-respective-logs-of-amazon-relational-database-service-amazon-rds-are-enabled\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_226\u001b[0m: Ensure DB instance gets all minor upgrades automatically\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n"]
[13.915, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0me\u001b[1m)\u001b[0m\n\n    \u001b[3mPostponing minor engine patches leaves known database vulnerabilities in place — often for months. \u001b[0m\n\u001b[3mAutomatic minor upgrades implement the ongoing maintenance and vulnerability handling NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3me\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m \u001b[0m\n"]
[14.025, "o", "\u001b[3mrequires of systems in production.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable automatic minor version upgrades:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"main\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[14.135, "o", "      \u001b[2m    auto_minor_version_upgrade = true\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430320;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-aws-db-instance-gets-all-minor-upgrades-automatically\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_157\u001b[0m: Ensure that RDS instances have Multi-AZ enabled\n"]
[14.245, "o", "    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n    \u001b[3mA single-AZ database has no standby: an availability-zone failure takes the data offline until manual \u001b[0m\n"]
[14.355, "o", "\u001b[3mrecovery. Multi-AZ provides automatic failover, supporting the availability obligation of GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m \u001b[0m\n\u001b[3mand business continuity under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable Multi-AZ deployment:\u001b[0m\n"]
[14.465, "o", "      \u001b[2m  multi_az = true\u001b[0m\n\n    \u001b]8;id=13430323;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/general-73\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_161\u001b[0m: Ensure RDS database has IAM authentication enabled\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n"]
[14.575, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mRelying only on static database passwords means no centralized revocation or rotation and passwords that \u001b[0m\n\u001b[3mare easily shared or leaked. IAM database authentication ties DB access to IAM identities, strengthening the \u001b[0m\n"]
[14.685, "o", "\u001b[3maccess control of NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and the confidentiality control of GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable IAM database authentication:\u001b[0m\n      \u001b[2m  iam_database_authentication_enabled = true\u001b[0m\n"]
[14.795, "o", "\n    \u001b]8;id=13430326;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-iam-policies/ensure-rds-database-has-iam-authentication-enabled\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV2_AWS_30\u001b[0m: Ensure Postgres RDS as aws_db_instance has Query Logging enabled\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n"]
[14.905, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout Postgres log capture \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mlog_connections, log_disconnections, log_statement\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m there is no record of \u001b[0m\n\u001b[3mwho touched personal data in the database, defeating the incident detection and analysis NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m \u001b[0m\n\u001b[3mrequires and the accountable processing security of GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n"]
[15.015, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable the logging parameters in the instance's parameter group:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_parameter_group\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"main\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    parameter \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m name = \u001b[0m\u001b[2;32m\"log_connections\"\u001b[0m\u001b[2m  value = \u001b[0m\u001b[2;32m\"1\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[15.125, "o", "      \u001b[2m    parameter \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m name = \u001b[0m\u001b[2;32m\"log_disconnections\"\u001b[0m\u001b[2m value = \u001b[0m\u001b[2;32m\"1\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430329;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-postgres-rds-has-query-logging-enabled\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[34m●\u001b[0m \u001b[1mCKV_AWS_353\u001b[0m: Ensure that RDS instances have performance insights enabled\n"]
[15.235, "o", "    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mPerformance Insights records query-level activity over time — the evidence needed to spot anomalous access\u001b[0m\n"]
[15.345, "o", "\u001b[3mpatterns and analyse database incidents under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable Performance Insights on the instance:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"main\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[15.455, "o", "      \u001b[2m    performance_insights_enabled = true\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430332;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-logging-policies/bc-aws-353\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_60\u001b[0m: Ensure RDS instance with copy tags to snapshots is enabled\n"]
[15.565, "o", "    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n    \u001b[3mSnapshots without the instance's tags cannot be found by restore runbooks or retention policies, so \u001b[0m\n"]
[15.675, "o", "\u001b[3mrecovery depends on tribal knowledge. Tag propagation is part of accountable backup management under NIS2 Art.\u001b[0m\n\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mCopy tags onto snapshots:\u001b[0m\n"]
[15.785, "o", "      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"main\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    copy_tags_to_snapshot = true\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430335;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/bc-aws-2-60\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n"]
[15.895, "o", "\u001b[1;36mFile: \u001b[0m\u001b[1;36m/\u001b[0m\u001b[1;36ms3.tf\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_55\u001b[0m: Ensure S3 bucket has ignore public ACLs enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket_public_access_block.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m12\u001b[0m-\u001b[1;36m19\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n"]
[16.005, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWith ignore_public_acls disabled, public ACLs applied to the bucket or its objects are honoured rather \u001b[0m\n\u001b[3mthan neutralised, allowing anonymous read/write and undermining the confidentiality control of GDPR Art. \u001b[0m\n\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n"]
[16.115, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable the guardrail on the bucket's public access block:\u001b[0m\n      \u001b[2m  ignore_public_acls = true\u001b[0m\n\n    \u001b]8;id=13430338;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/bc-aws-s3-21\u001b\\→ Documentation\u001b]8;;\u001b\\\n"]
[16.225, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_54\u001b[0m: Ensure S3 bucket has block public policy enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket_public_access_block.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m12\u001b[0m-\u001b[1;36m19\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n"]
[16.335, "o", "\n    \u001b[3mWith block_public_policy disabled, a bucket policy can grant anonymous access to objects, silently \u001b[0m\n\u001b[3mexposing personal data. It is the policy-side counterpart to CKV_AWS_53 and a direct confidentiality risk \u001b[0m\n\u001b[3munder GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n"]
[16.445, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable the guardrail on the bucket's public access block:\u001b[0m\n      \u001b[2m  block_public_policy = true\u001b[0m\n\n    \u001b]8;id=13430341;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/bc-aws-s3-20\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n"]
[16.555, "o", "  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_53\u001b[0m: Ensure S3 bucket has block public ACLS enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket_public_access_block.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m12\u001b[0m-\u001b[1;36m19\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n"]
[16.665, "o", "    \u001b[3mWith block_public_acls disabled, a future ACL change can silently make objects public, defeating the \u001b[0m\n\u001b[3mconfidentiality control GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires. The public access block is the account-level guardrail \u001b[0m\n\u001b[3mthat prevents that drift.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[16.775, "o", "      \u001b[2mEnable the guardrail on the bucket's public access block:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_public_access_block\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket                  = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    block_public_acls       = true\u001b[0m\n      \u001b[2m    ignore_public_acls      = true\u001b[0m\n      \u001b[2m    block_public_policy     = true\u001b[0m\n"]
[16.885, "o", "      \u001b[2m    restrict_public_buckets = true\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430344;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/bc-aws-s3-19\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_56\u001b[0m: Ensure S3 bucket has \u001b[32m'restrict_public_buckets'\u001b[0m enabled\n"]
[16.995, "o", "    \u001b[2mResource:\u001b[0m aws_s3_bucket_public_access_block.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m12\u001b[0m-\u001b[1;36m19\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWith restrict_public_buckets disabled, a public bucket policy grants access to all principals and \u001b[0m\n"]
[17.105, "o", "\u001b[3manonymous users rather than only authorised AWS services and users, widening exposure of personal data \u001b[0m\n\u001b[3mcontrary to GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable the guardrail on the bucket's public access block:\u001b[0m\n"]
[17.215, "o", "      \u001b[2m  restrict_public_buckets = true\u001b[0m\n\n    \u001b]8;id=13430347;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/bc-aws-s3-22\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV2_AWS_6\u001b[0m: Ensure that S3 bucket has a Public Access block\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n"]
[17.325, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mA bucket with no aws_s3_bucket_public_access_block has no safety net against accidental public exposure \u001b[0m\n\u001b[3mvia ACLs or bucket policy - a standing confidentiality risk for any personal data under GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n"]
[17.435, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mAttach a public access block that denies all public access \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2msee CKV_AWS_53 for the\u001b[0m\n      \u001b[2mfull resource\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m; at minimum:\u001b[0m\n      \u001b[2m  block_public_acls       = true\u001b[0m\n"]
[17.545, "o", "      \u001b[2m  block_public_policy     = true\u001b[0m\n      \u001b[2m  ignore_public_acls      = true\u001b[0m\n      \u001b[2m  restrict_public_buckets = true\u001b[0m\n\n    \u001b]8;id=13430350;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/s3-bucket-should-have-public-access-blocks-defaults-to-false-if-the-public-access-block-is-not-attached\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n"]
[17.655, "o", "  \u001b[31m●\u001b[0m \u001b[1mCKV2_AWS_6\u001b[0m: Ensure that S3 bucket has a Public Access block\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n"]
[17.765, "o", "    \u001b[3mA bucket with no aws_s3_bucket_public_access_block has no safety net against accidental public exposure \u001b[0m\n\u001b[3mvia ACLs or bucket policy - a standing confidentiality risk for any personal data under GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mAttach a public access block that denies all public access \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2msee CKV_AWS_53 for the\u001b[0m\n"]
[17.875, "o", "      \u001b[2mfull resource\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m; at minimum:\u001b[0m\n      \u001b[2m  block_public_acls       = true\u001b[0m\n      \u001b[2m  block_public_policy     = true\u001b[0m\n      \u001b[2m  ignore_public_acls      = true\u001b[0m\n      \u001b[2m  restrict_public_buckets = true\u001b[0m\n\n"]
[17.985, "o", "    \u001b]8;id=13430352;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/s3-bucket-should-have-public-access-blocks-defaults-to-false-if-the-public-access-block-is-not-attached\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_145\u001b[0m: Ensure that S3 buckets are encrypted with KMS by default\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n"]
[18.095, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mh\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0ma\u001b[1m)\u001b[0m\n\n    \u001b[3mBuckets without KMS-managed encryption at rest lack the auditable key control and key-rotation guarantees \u001b[0m\n\u001b[3mexpected of encrypted personal data. GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3ma\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m names encryption explicitly; NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mh\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m \u001b[0m\n\u001b[3mrequires cryptography policies.\u001b[0m\n\n"]
[18.205, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mConfigure default SSE-KMS on the bucket:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_server_side_encryption_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    rule \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[18.315, "o", "      \u001b[2m      apply_server_side_encryption_by_default \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m        sse_algorithm     = \u001b[0m\u001b[2;32m\"aws:kms\"\u001b[0m\n      \u001b[2m        kms_master_key_id = aws_kms_key.s3.arn\u001b[0m\n      \u001b[2m      \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[18.425, "o", "\n    \u001b]8;id=13430355;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-that-s3-buckets-are-encrypted-with-kms-by-default\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_145\u001b[0m: Ensure that S3 buckets are encrypted with KMS by default\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n"]
[18.535, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mh\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0ma\u001b[1m)\u001b[0m\n\n    \u001b[3mBuckets without KMS-managed encryption at rest lack the auditable key control and key-rotation guarantees \u001b[0m\n\u001b[3mexpected of encrypted personal data. GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3ma\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m names encryption explicitly; NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mh\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m \u001b[0m\n\u001b[3mrequires cryptography policies.\u001b[0m\n"]
