[3.01, "o", "\n\u001b[1m═══════════════════════════════════════════════════\u001b[0m\n\u001b[1m  tf-eu-guard: EU Compliance Scan Report\u001b[0m\n\u001b[1m═══════════════════════════════════════════════════\u001b[0m\n\n\u001b[1mTotal Findings:\u001b[0m \u001b[1;36m53\u001b[0m\n"]
[3.12, "o", "  \u001b[31m●\u001b[0m CRITICAL: \u001b[1;36m7\u001b[0m\n  \u001b[31m●\u001b[0m HIGH: \u001b[1;36m15\u001b[0m\n  \u001b[33m●\u001b[0m MEDIUM: \u001b[1;36m23\u001b[0m\n  \u001b[34m●\u001b[0m LOW: \u001b[1;36m8\u001b[0m\n\n\n"]
[3.23, "o", "\u001b[1;36mFile: \u001b[0m\u001b[1;36m/\u001b[0m\u001b[1;36miam.tf\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_287\u001b[0m: Ensure IAM policies does not allow credentials exposure\n    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n"]
[3.34, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mPolicies that permit credential-generation actions \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3msts:GetFederationToken, iam:CreateAccessKey, ec2:GetPasswordData, etc.\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m let an attacker mint new credentials and pivot, undermining the confidentiality controls GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires and the access control NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m mandates.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[3.45, "o", "      \u001b[2mRemove credential-exposing actions and scope to least privilege:\u001b[0m\n      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"sts:*\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"iam:CreateAccessKey\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  # After:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"s3:GetObject\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"s3:PutObject\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:s3:::my-app-data/*\"\u001b[0m\n"]
[3.56, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_288\u001b[0m: Ensure IAM policies does not allow data exfiltration\n    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[3.67, "o", "\n    \u001b[3mBroad read actions on all resources \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3ms3:GetObject, secretsmanager:GetSecretValue, rds:DownloadDBLogFilePortion on \u001b[0m\u001b[3;32m\"*\"\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m enable bulk exfiltration of data — if that data is personal, an exfiltration path through them could lead to a personal data breach. These permissions may weaken the confidentiality of processing expected by GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and the access control expected by NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mConstrain read actions to specific resource ARNs, never \u001b[0m\u001b[2;32m\"*\"\u001b[0m\u001b[2m:\u001b[0m\n"]
[3.78, "o", "      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"s3:GetObject\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:s3:::approved-bucket/*\"\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_289\u001b[0m: Ensure IAM policies does not allow permissions management \u001b[35m/\u001b[0m resource exposure without constraints\n    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n"]
[3.89, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mPermissions-management actions \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3miam:PutUserPolicy, iam:AttachUserPolicy, s3:PutBucketPolicy, etc.\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m on unconstrained resources let a principal rewrite who can access what, collapsing access control \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mNIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and putting the confidentiality of all data at risk \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n"]
[4.0, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mRemove permissions-management actions from workload policies, or bound them\u001b[0m\n      \u001b[2mwith a permissions boundary and explicit resource ARNs:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"iam:AttachUserPolicy\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:iam::123456789012:user/app-*\"\u001b[0m\n\n"]
[4.11, "o", "  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_289\u001b[0m: Ensure IAM policies does not allow permissions management \u001b[35m/\u001b[0m resource exposure without constraints\n    \u001b[2mResource:\u001b[0m aws_iam_role_policy.app_role_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m53\u001b[0m-\u001b[1;36m67\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n"]
[4.22, "o", "    \u001b[3mPermissions-management actions \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3miam:PutUserPolicy, iam:AttachUserPolicy, s3:PutBucketPolicy, etc.\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m on unconstrained resources let a principal rewrite who can access what, collapsing access control \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mNIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and putting the confidentiality of all data at risk \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mRemove permissions-management actions from workload policies, or bound them\u001b[0m\n      \u001b[2mwith a permissions boundary and explicit resource ARNs:\u001b[0m\n"]
[4.33, "o", "      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"iam:AttachUserPolicy\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:iam::123456789012:user/app-*\"\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_273\u001b[0m: Ensure access is controlled through SSO and not AWS IAM defined users\n    \u001b[2mResource:\u001b[0m aws_iam_user.app_user\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m8\u001b[0m\n"]
[4.44, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mLong-lived IAM users bypass centralized identity management and SSO, making it difficult to enforce MFA, audit access centrally, and revoke credentials quickly during an incident. NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires effective access control policies.\u001b[0m\n\n\n"]
[4.55, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mDelete standing IAM users and federate access through AWS IAM Identity Center \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mSSO\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  # Remove:\u001b[0m\n      \u001b[2m  # resource \u001b[0m\u001b[2;32m\"aws_iam_user\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"admin\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m \u001b[0m\u001b[2;33m...\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  # Use Identity Center permission sets + account assignments instead\u001b[0m\n      \u001b[2m  # \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mmanaged via aws_ssoadmin_* resources or the Identity Center console\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m.\u001b[0m\n"]
[4.66, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_290\u001b[0m: Ensure IAM policies does not allow write access without constraints\n    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[4.77, "o", "\n    \u001b[3mWrite actions \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mCreate/Put/Update/Delete\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m allowed on Resource \u001b[0m\u001b[3;32m\"*\"\u001b[0m\u001b[3m let a principal modify or destroy any resource in the account, threatening the integrity and availability of personal data \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and breaking the least-privilege access control of NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mScope write actions to the specific resources the workload manages:\u001b[0m\n"]
[4.88, "o", "      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"dynamodb:PutItem\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"dynamodb:UpdateItem\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:dynamodb:eu-west-1:123456789012:table/app-*\"\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_355\u001b[0m: Ensure no IAM policies documents allow \u001b[32m\"*\"\u001b[0m as a statement's resource for restrictable actions\n    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n"]
[4.99, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mUsing Resource \u001b[0m\u001b[3;32m\"*\"\u001b[0m\u001b[3m for actions that support resource-level scoping lets the policy reach every object in the account, not just those the workload owns. This over-broad reach undermines the access segregation NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m expects and the data confidentiality GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires.\u001b[0m\n\n\n"]
[5.1, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mConstrain each statement to specific resource ARNs:\u001b[0m\n      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"*\"\u001b[0m\n      \u001b[2m  # After:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:s3:::my-app-data/*\"\u001b[0m\n"]
[5.21, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_290\u001b[0m: Ensure IAM policies does not allow write access without constraints\n    \u001b[2mResource:\u001b[0m aws_iam_role_policy.app_role_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m53\u001b[0m-\u001b[1;36m67\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[5.32, "o", "\n    \u001b[3mWrite actions \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mCreate/Put/Update/Delete\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m allowed on Resource \u001b[0m\u001b[3;32m\"*\"\u001b[0m\u001b[3m let a principal modify or destroy any resource in the account, threatening the integrity and availability of personal data \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and breaking the least-privilege access control of NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mScope write actions to the specific resources the workload manages:\u001b[0m\n"]
[5.43, "o", "      \u001b[2m  \u001b[0m\u001b[2;32m\"Action\"\u001b[0m\u001b[2m: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"dynamodb:PutItem\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"dynamodb:UpdateItem\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:dynamodb:eu-west-1:123456789012:table/app-*\"\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_355\u001b[0m: Ensure no IAM policies documents allow \u001b[32m\"*\"\u001b[0m as a statement's resource for restrictable actions\n    \u001b[2mResource:\u001b[0m aws_iam_role_policy.app_role_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m53\u001b[0m-\u001b[1;36m67\u001b[0m\n"]
[5.54, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mUsing Resource \u001b[0m\u001b[3;32m\"*\"\u001b[0m\u001b[3m for actions that support resource-level scoping lets the policy reach every object in the account, not just those the workload owns. This over-broad reach undermines the access segregation NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m expects and the data confidentiality GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires.\u001b[0m\n\n\n"]
[5.65, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mConstrain each statement to specific resource ARNs:\u001b[0m\n      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"*\"\u001b[0m\n      \u001b[2m  # After:\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[2;32m\"Resource\"\u001b[0m\u001b[2m: \u001b[0m\u001b[2;32m\"arn:aws:s3:::my-app-data/*\"\u001b[0m\n"]
[5.76, "o", "\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_40\u001b[0m: Ensure IAM policies are attached only to groups or roles \u001b[1m(\u001b[0mReducing access management complexity may in-turn reduce opportunity for a principal to inadvertently receive or retain excessive privileges.\u001b[1m)\u001b[0m\n    \u001b[2mResource:\u001b[0m aws_iam_user_policy.app_user_policy\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m29\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[5.87, "o", "\n    \u001b[3mAttaching policies directly to individual IAM users makes entitlements hard to review and revoke at scale, weakening the asset- and access-management discipline NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m expects. Group/role attachment keeps privileges auditable.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mAttach the policy to a group or role and add the user to the group:\u001b[0m\n"]
[5.98, "o", "      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_iam_group_policy_attachment\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"app\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    group      = aws_iam_group.app.name\u001b[0m\n      \u001b[2m    policy_arn = aws_iam_policy.app.arn\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n\u001b[1;36mFile: \u001b[0m\u001b[1;36m/\u001b[0m\u001b[1;36mmain.tf\u001b[0m\n"]
[6.09, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mEUGUARD_GDPR_002\u001b[0m: Review AWS provider regions outside the EU/EEA for GDPR Chapter V transfer safeguards\n    \u001b[2mResource:\u001b[0m aws.default\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m13\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;36m44\u001b[0m\n"]
[6.2, "o", "\n    \u001b[3mA provider pinned to a known AWS region outside the EU/EEA is a technical signal that personal-data processing may involve a third-country transfer. GDPR Chapter V \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mArt. \u001b[0m\u001b[1;3;36m44\u001b[0m\u001b[3m-\u001b[0m\u001b[1;3;36m49\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m may require an adequacy decision, Standard Contractual Clauses, Binding Corporate Rules, or another safeguard, but this configuration alone cannot show whether a transfer occurs or whether its mechanism is lawful. Treat this as a hedged Chapter V review signal, not a definitive legal conclusion.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mConfirm the data flows and document the applicable Chapter V mechanism,\u001b[0m\n"]
[6.31, "o", "      \u001b[2mor pin the provider to an EU/EEA region:\u001b[0m\n      \u001b[2m  provider \u001b[0m\u001b[2;32m\"aws\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m region = \u001b[0m\u001b[2;32m\"eu-central-1\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mEUGUARD_POLICY_001\u001b[0m: Ensure the AWS provider region is within the configured residency policy\n    \u001b[2mResource:\u001b[0m aws.default\n    \u001b[2mLines:\u001b[0m \u001b[1;36m11\u001b[0m-\u001b[1;36m13\u001b[0m\n"]
[6.42, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mPOLICY\u001b[0m Policy RESIDENCY-\u001b[1;36m001\u001b[0m\n\n    \u001b[3mThe AWS provider region is outside the configured residency policy \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3m--residency-policy: eu-eea by default, eusc for the AWS European Sovereign Cloud only, or a custom allowlist\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m. Under eusc, a commercial EU/EEA region such as eu-central-\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[3m is outside the policy even though it may satisfy the GDPR geographic baseline. An unresolved variable region cannot be proven to be in policy statically and also fails. Any Chapter V transfer review for a non-EU/EEA region is reported separately by EUGUARD_GDPR_002. This finding is a project-policy deviation, not a GDPR legal conclusion.\u001b[0m\n\n\n"]
[6.53, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mPin every aws provider block to a region allowed by the policy:\u001b[0m\n      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  provider \u001b[0m\u001b[2;32m\"aws\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m region = \u001b[0m\u001b[2;32m\"us-east-1\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  # After \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2meu-eea policy\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  provider \u001b[0m\u001b[2;32m\"aws\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m region = \u001b[0m\u001b[2;32m\"eu-central-1\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[6.64, "o", "      \u001b[2mUnder --residency-policy eusc use region = \u001b[0m\u001b[2;32m\"eusc-de-east-1\"\u001b[0m\u001b[2m. An unresolved\u001b[0m\n      \u001b[2mvariable region needs a literal value in the scanned configuration.\u001b[0m\n\n\u001b[1;36mFile: \u001b[0m\u001b[1;36m/\u001b[0m\u001b[1;36mnetwork.tf\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_24\u001b[0m: Ensure no security groups allow ingress from \u001b[1;92m0.0.0.0\u001b[0m:\u001b[1;36m0\u001b[0m to port \u001b[1;36m22\u001b[0m\n"]
[6.75, "o", "    \u001b[2mResource:\u001b[0m aws_security_group.web\n    \u001b[2mLines:\u001b[0m \u001b[1;36m61\u001b[0m-\u001b[1;36m93\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mSSH \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mport \u001b[0m\u001b[1;3;36m22\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m open to \u001b[0m\u001b[1;3;92m0.0.0.0\u001b[0m\u001b[3m/\u001b[0m\u001b[1;3;36m0\u001b[0m\u001b[3m exposes administrative shell access to the entire internet, inviting brute-force and exploitation of any host that may process personal data. This may weaken the network access-control measures relevant to NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and the confidentiality safeguards expected by GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n"]
[6.86, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mRestrict SSH to a bastion or corporate CIDR, never the internet. Remove the\u001b[0m\n      \u001b[2mwildcard in both address families when both attributes are present:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_security_group\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"admin\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[6.97, "o", "      \u001b[2m    ingress \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m      from_port        = \u001b[0m\u001b[1;2;36m22\u001b[0m\n      \u001b[2m      to_port          = \u001b[0m\u001b[1;2;36m22\u001b[0m\n      \u001b[2m      protocol         = \u001b[0m\u001b[2;32m\"tcp\"\u001b[0m\n      \u001b[2m      # Before: cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"0.0.0.0/0\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      cidr_blocks      = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"10.0.0.0/8\"\u001b[0m\u001b[1;2m]\u001b[0m\u001b[2m       # or a specific admin IPv4 range\u001b[0m\n"]
[7.08, "o", "      \u001b[2m      # Before: ipv6_cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"::/0\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      ipv6_cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"2001:db8:1234::/48\"\u001b[0m\u001b[1;2m]\u001b[0m\u001b[2m # or remove IPv6 ingress\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2mUse SSM Session Manager instead of exposing an administrative port where possible.\u001b[0m\n\n"]
[7.19, "o", "  \u001b[33m●\u001b[0m \u001b[1mCKV2_AWS_11\u001b[0m: Ensure VPC flow logging is enabled in all VPCs\n    \u001b[2mResource:\u001b[0m aws_vpc.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m11\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n"]
[7.3, "o", "    \u001b[3mWithout VPC flow logs there is no network-level record of accepted/rejected connections, so lateral movement and exfiltration attempts cannot be detected or reconstructed. NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires detection and analysis of incidents.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable flow logs for the VPC:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_flow_log\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[7.41, "o", "      \u001b[2m    vpc_id          = aws_vpc.main.id\u001b[0m\n      \u001b[2m    traffic_type    = \u001b[0m\u001b[2;32m\"ALL\"\u001b[0m\n      \u001b[2m    log_destination = aws_cloudwatch_log_group.vpc_flow.arn\u001b[0m\n      \u001b[2m    iam_role_arn    = aws_iam_role.vpc_flow.arn\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n"]
[7.52, "o", "  \u001b[33m●\u001b[0m \u001b[1mCKV2_AWS_12\u001b[0m: Ensure the default security group of every VPC restricts all traffic\n    \u001b[2mResource:\u001b[0m aws_vpc.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m11\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n"]
[7.63, "o", "    \u001b[3mAn unmanaged default security group can implicitly allow traffic between any resources that fall back to it, bypassing intended segmentation. NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m expects deliberate, least-privilege network access control.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mManage the default SG and strip all ingress/egress:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_default_security_group\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"default\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[7.74, "o", "      \u001b[2m    vpc_id = aws_vpc.main.id\u001b[0m\n      \u001b[2m    # no ingress or egress blocks = deny all\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_130\u001b[0m: Ensure VPC subnets do not assign public IP by default\n    \u001b[2mResource:\u001b[0m aws_subnet.public_a\n"]
[7.85, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m14\u001b[0m-\u001b[1;36m24\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mSubnets that auto-assign public IPs place workloads directly on the internet by default, widening the attack surface for systems that may process personal data - a confidentiality risk \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and weak network segmentation under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n"]
[7.96, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mDisable automatic public IP assignment; use NAT for egress:\u001b[0m\n      \u001b[2m  map_public_ip_on_launch = false\u001b[0m\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_130\u001b[0m: Ensure VPC subnets do not assign public IP by default\n"]
[8.07, "o", "    \u001b[2mResource:\u001b[0m aws_subnet.public_b\n    \u001b[2mLines:\u001b[0m \u001b[1;36m26\u001b[0m-\u001b[1;36m36\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mSubnets that auto-assign public IPs place workloads directly on the internet by default, widening the attack surface for systems that may process personal data - a confidentiality risk \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mGDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and weak network segmentation under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n"]
[8.18, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mDisable automatic public IP assignment; use NAT for egress:\u001b[0m\n      \u001b[2m  map_public_ip_on_launch = false\u001b[0m\n\n"]
[8.29, "o", "  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_260\u001b[0m: Ensure no security groups allow ingress from \u001b[1;92m0.0.0.0\u001b[0m:\u001b[1;36m0\u001b[0m to port \u001b[1;36m80\u001b[0m\n    \u001b[2mResource:\u001b[0m aws_security_group.web\n    \u001b[2mLines:\u001b[0m \u001b[1;36m61\u001b[0m-\u001b[1;36m93\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n"]
[8.4, "o", "    \u001b[3mPlain-HTTP \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mport \u001b[0m\u001b[1;3;36m80\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m open to the world serves traffic unencrypted and widens the attack surface. Where it fronts systems processing personal data it weakens the network access control expected by NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m; traffic should terminate TLS at a load balancer instead.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mFront the service with HTTPS and restrict or redirect port \u001b[0m\u001b[1;2;36m80\u001b[0m\u001b[2m. If the rule\u001b[0m\n      \u001b[2mhas both address families, scope both and do not leave either wildcard:\u001b[0m\n"]
[8.51, "o", "      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_security_group\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"web\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    ingress \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m      from_port        = \u001b[0m\u001b[1;2;36m80\u001b[0m\n      \u001b[2m      to_port          = \u001b[0m\u001b[1;2;36m80\u001b[0m\n      \u001b[2m      protocol         = \u001b[0m\u001b[2;32m\"tcp\"\u001b[0m\n      \u001b[2m      # Terminate TLS \u001b[0m\u001b[1;2m(\u001b[0m\u001b[1;2;36m443\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m at an ALB and redirect \u001b[0m\u001b[1;2;36m80\u001b[0m\u001b[2m -> \u001b[0m\u001b[1;2;36m443\u001b[0m\u001b[2m, or scope both CIDRs:\u001b[0m\n"]
[8.62, "o", "      \u001b[2m      # Before: cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"0.0.0.0/0\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      cidr_blocks      = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"10.0.0.0/8\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      # Before: ipv6_cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"::/0\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      ipv6_cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"2001:db8:1234::/48\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[8.73, "o", "\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_382\u001b[0m: Ensure no security groups allow egress from \u001b[1;92m0.0.0.0\u001b[0m:\u001b[1;36m0\u001b[0m to port \u001b[1;36m-1\u001b[0m\n    \u001b[2mResource:\u001b[0m aws_security_group.web\n    \u001b[2mLines:\u001b[0m \u001b[1;36m61\u001b[0m-\u001b[1;36m93\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[8.84, "o", "\n    \u001b[3mUnrestricted egress \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mall ports/protocols to \u001b[0m\u001b[1;3;92m0.0.0.0\u001b[0m\u001b[3m/\u001b[0m\u001b[1;3;36m0\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m gives a compromised host a clear path to exfiltrate data or reach command-and-control infrastructure. Egress filtering is part of the network segmentation and access control under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mScope egress to the destinations and ports the workload actually needs in\u001b[0m\n"]
[8.95, "o", "      \u001b[2mboth address families:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_security_group\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"app\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    egress \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m      from_port        = \u001b[0m\u001b[1;2;36m443\u001b[0m\n      \u001b[2m      to_port          = \u001b[0m\u001b[1;2;36m443\u001b[0m\n      \u001b[2m      protocol         = \u001b[0m\u001b[2;32m\"tcp\"\u001b[0m\n"]
[9.06, "o", "      \u001b[2m      # Before: cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"0.0.0.0/0\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      cidr_blocks      = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"10.0.0.0/8\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      # Before: ipv6_cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"::/0\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      ipv6_cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"2001:db8:1234::/48\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[9.17, "o", "\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_382\u001b[0m: Ensure no security groups allow egress from \u001b[1;92m0.0.0.0\u001b[0m:\u001b[1;36m0\u001b[0m to port \u001b[1;36m-1\u001b[0m\n    \u001b[2mResource:\u001b[0m aws_security_group.rds\n    \u001b[2mLines:\u001b[0m \u001b[1;36m96\u001b[0m-\u001b[1;36m119\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[9.28, "o", "\n    \u001b[3mUnrestricted egress \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mall ports/protocols to \u001b[0m\u001b[1;3;92m0.0.0.0\u001b[0m\u001b[3m/\u001b[0m\u001b[1;3;36m0\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m gives a compromised host a clear path to exfiltrate data or reach command-and-control infrastructure. Egress filtering is part of the network segmentation and access control under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mScope egress to the destinations and ports the workload actually needs in\u001b[0m\n"]
[9.39, "o", "      \u001b[2mboth address families:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_security_group\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"app\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    egress \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m      from_port        = \u001b[0m\u001b[1;2;36m443\u001b[0m\n      \u001b[2m      to_port          = \u001b[0m\u001b[1;2;36m443\u001b[0m\n      \u001b[2m      protocol         = \u001b[0m\u001b[2;32m\"tcp\"\u001b[0m\n"]
[9.5, "o", "      \u001b[2m      # Before: cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"0.0.0.0/0\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      cidr_blocks      = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"10.0.0.0/8\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      # Before: ipv6_cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"::/0\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m      ipv6_cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"2001:db8:1234::/48\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[9.61, "o", "\n  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_5\u001b[0m: Ensure that Security Groups are attached to another resource\n    \u001b[2mResource:\u001b[0m aws_security_group.web\n    \u001b[2mLines:\u001b[0m \u001b[1;36m61\u001b[0m-\u001b[1;36m93\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[9.72, "o", "\n    \u001b[3mOrphaned security groups accumulate stale rules that later get attached \u001b[0m\u001b[3;32m\"because they were there\"\u001b[0m\u001b[3m, importing unintended access into live environments — an unmanaged asset under the access control and asset management of NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mReference every security group from the resource it guards \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mand delete the rest\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n"]
[9.83, "o", "      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"app\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    vpc_security_group_ids = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2maws_security_group.app.id\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[34m●\u001b[0m \u001b[1mCKV_AWS_23\u001b[0m: Ensure every security group and rule has a description\n    \u001b[2mResource:\u001b[0m aws_security_group.rds\n"]
[9.94, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m96\u001b[0m-\u001b[1;36m119\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n\n    \u001b[3mUndocumented rules cannot be reviewed: nobody can tell which rule is a deliberate control and which is leftover access. Descriptions are what make rule review — and therefore accountable access control under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m — possible.\u001b[0m\n\n"]
[10.05, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mDescribe the purpose of every group and rule:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_security_group\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"web\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    description = \u001b[0m\u001b[2;32m\"Web tier: HTTP from office CIDR only\"\u001b[0m\n      \u001b[2m    ingress \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[10.16, "o", "      \u001b[2m      description = \u001b[0m\u001b[2;32m\"HTTP from office\"\u001b[0m\n      \u001b[2m      cidr_blocks = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"203.0.113.0/24\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n\u001b[1;36mFile: \u001b[0m\u001b[1;36m/\u001b[0m\u001b[1;36mrds.tf\u001b[0m\n"]
[10.27, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_17\u001b[0m: Ensure all data stored in RDS is not publicly accessible\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[10.38, "o", "\n    \u001b[3mA publicly accessible database is reachable from the internet, exposing personal data to credential-stuffing and exploitation. This may weaken the confidentiality safeguards expected by GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and the access control measures relevant to NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mKeep the instance private and reach it only from within the VPC:\u001b[0m\n"]
[10.49, "o", "      \u001b[2m  publicly_accessible = false\u001b[0m\n      \u001b[2m  # place the instance in private subnets via a db_subnet_group and\u001b[0m\n      \u001b[2m  # restrict the security group to internal CIDRs only.\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mEUGUARD_NIS2_001\u001b[0m: Ensure secrets are not hardcoded in Terraform \u001b[1m(\u001b[0muse variables/Secrets Manager\u001b[1m)\u001b[0m\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n"]
[10.6, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mCRITICAL\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0me\u001b[1m)\u001b[0m\n\n    \u001b[3mA literal credential in a supported database/cache secret argument or a CodeBuild plaintext sensitive environment variable is readable by anyone with repository or state access, cannot be rotated centrally, and frequently leaks through CI logs. Storing secrets in code is an insecure-development practice under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3me\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and, where the secret protects personal data, a confidentiality risk under GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m. Provider credentials, EC2 user_data, and Lambda environment variables are intentionally handled by Checkov's CKV_AWS_41, CKV_AWS_46, and CKV_AWS_45 checks instead of this rule.\u001b[0m\n\n"]
[10.71, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mNever inline secrets in a supported field. Source them from a secrets\u001b[0m\n      \u001b[2mmanager or a sensitive variable injected at apply time:\u001b[0m\n      \u001b[2m  # Before:\u001b[0m\n      \u001b[2m  password = \u001b[0m\u001b[2;32m\"ChangeMe123!\"\u001b[0m\n"]
[10.82, "o", "      \u001b[2m  # After:\u001b[0m\n      \u001b[2m  password = data.aws_secretsmanager_secret_version.db.secret_string\u001b[0m\n      \u001b[2m  # or a variable marked `sensitive` and sourced from the environment/a vault.\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_133\u001b[0m: Ensure that RDS instances has backup policy\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n"]
[10.93, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n    \u001b[3mA zero-day backup retention means no point-in-time recovery: hardware failure, corruption, or ransomware results in permanent data loss. Both NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m require the ability to restore availability of data.\u001b[0m\n\n"]
[11.04, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mSet a non-zero backup retention window \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2m>= \u001b[0m\u001b[1;2;36m7\u001b[0m\u001b[2m days recommended\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  backup_retention_period = \u001b[0m\u001b[1;2;36m7\u001b[0m\n      \u001b[2m  backup_window           = \u001b[0m\u001b[2;32m\"03:00-04:00\"\u001b[0m\n\n"]
[11.15, "o", "  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_16\u001b[0m: Ensure all data stored in the RDS is securely encrypted at rest\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0ma\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mh\u001b[1m)\u001b[0m\n\n"]
[11.26, "o", "    \u001b[3mAn unencrypted RDS instance leaves personal data readable on the underlying storage and in snapshots. GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3ma\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m names encryption explicitly and NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mh\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires cryptography controls for data at rest.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable storage encryption \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mimmutable - requires recreate/restore\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[11.37, "o", "      \u001b[2m    storage_encrypted = true\u001b[0m\n      \u001b[2m    kms_key_id        = aws_kms_key.rds.arn\u001b[0m\n      \u001b[2m    # \u001b[0m\u001b[2;33m...\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV2_AWS_30\u001b[0m: Ensure Postgres RDS as aws_db_instance has Query Logging enabled\n"]
[11.48, "o", "    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout Postgres log capture \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mlog_statement, log_min_duration_statement\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m there is no record of who touched personal data in the database, weakening the incident detection and analysis NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires and the accountable processing security of GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n"]
[11.59, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable the logging parameters in a parameter group attached to the instance:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_parameter_group\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"main\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    family = \u001b[0m\u001b[2;32m\"postgres15\"\u001b[0m\n"]
[11.7, "o", "      \u001b[2m    parameter \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m      name  = \u001b[0m\u001b[2;32m\"log_statement\"\u001b[0m\n      \u001b[2m      value = \u001b[0m\u001b[2;32m\"all\"\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m    parameter \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m      name  = \u001b[0m\u001b[2;32m\"log_min_duration_statement\"\u001b[0m\n"]
[11.81, "o", "      \u001b[2m      value = \u001b[0m\u001b[2;32m\"1000\"\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"main\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    engine               = \u001b[0m\u001b[2;32m\"postgres\"\u001b[0m\n      \u001b[2m    parameter_group_name = aws_db_parameter_group.main.name\u001b[0m\n"]
[11.92, "o", "      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_118\u001b[0m: Ensure that enhanced monitoring is enabled for Amazon RDS instances\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n"]
[12.03, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout enhanced monitoring, OS-level metrics \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mCPU, memory, process and I/O activity\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m are unavailable, so resource-exhaustion attacks or anomalous database host behaviour cannot be detected or investigated - which may weaken the incident detection and handling required by NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[12.14, "o", "      \u001b[2mEnable enhanced monitoring with a monitoring role and a non-zero interval:\u001b[0m\n      \u001b[2m  monitoring_interval = \u001b[0m\u001b[1;2;36m60\u001b[0m\n      \u001b[2m  monitoring_role_arn = aws_iam_role.rds_monitoring.arn\u001b[0m\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_129\u001b[0m: Ensure that respective logs of Amazon Relational Database Service \u001b[1m(\u001b[0mAmazon RDS\u001b[1m)\u001b[0m are enabled\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n"]
[12.25, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout database engine logs exported to CloudWatch, suspicious queries and authentication failures leave no trail, so a data-access incident cannot be detected or investigated - which may weaken NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n"]
[12.36, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mExport the relevant engine logs:\u001b[0m\n      \u001b[2m  enabled_cloudwatch_logs_exports = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"postgresql\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"upgrade\"\u001b[0m\u001b[1;2m]\u001b[0m\n      \u001b[2m  # \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mfor MySQL: \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"audit\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"error\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"general\"\u001b[0m\u001b[2m, \u001b[0m\u001b[2;32m\"slowquery\"\u001b[0m\u001b[1;2m]\u001b[0m\u001b[1;2m)\u001b[0m\n\n"]
[12.47, "o", "  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_157\u001b[0m: Ensure that RDS instances have Multi-AZ enabled\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n"]
[12.58, "o", "    \u001b[3mA single-AZ database has no standby: an availability-zone failure takes the data offline until manual recovery. Multi-AZ provides automatic failover, supporting the availability obligation of GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and business continuity under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable Multi-AZ deployment:\u001b[0m\n      \u001b[2m  multi_az = true\u001b[0m\n"]
[12.69, "o", "\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_161\u001b[0m: Ensure RDS database has IAM authentication enabled\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mi\u001b[1m)\u001b[0m\n"]
[12.8, "o", "\n    \u001b[3mRelying only on static database passwords means no centralized revocation or rotation and passwords that are easily shared or leaked. IAM database authentication ties DB access to IAM identities, strengthening the access control of NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mi\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and the confidentiality control of GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable IAM database authentication:\u001b[0m\n"]
[12.91, "o", "      \u001b[2m  iam_database_authentication_enabled = true\u001b[0m\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_226\u001b[0m: Ensure DB instance gets all minor upgrades automatically\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n"]
[13.02, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0me\u001b[1m)\u001b[0m\n\n    \u001b[3mPostponing minor engine patches leaves known database vulnerabilities in place — often for months. Automatic minor upgrades implement the ongoing maintenance and vulnerability handling NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3me\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires of systems in production.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[13.13, "o", "      \u001b[2mEnable automatic minor version upgrades:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"main\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    auto_minor_version_upgrade = true\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_293\u001b[0m: Ensure that AWS database instances have deletion protection enabled\n"]
[13.24, "o", "    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout deletion protection, a mistaken or malicious destroy removes the database and its data with no confirmation barrier, threatening the availability that both NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m require.\u001b[0m\n"]
[13.35, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable deletion protection on the instance:\u001b[0m\n      \u001b[2m  deletion_protection = true\u001b[0m\n\n"]
[13.46, "o", "  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_60\u001b[0m: Ensure RDS instance with copy tags to snapshots is enabled\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n"]
[13.57, "o", "    \u001b[3mSnapshots without the instance's tags cannot be found by restore runbooks or retention policies, so recovery depends on tribal knowledge. Tag propagation is part of accountable backup management under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mCopy tags onto snapshots:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"main\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[13.68, "o", "      \u001b[2m    copy_tags_to_snapshot = true\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[34m●\u001b[0m \u001b[1mCKV_AWS_353\u001b[0m: Ensure that RDS instances have performance insights enabled\n    \u001b[2mResource:\u001b[0m aws_db_instance.main\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m30\u001b[0m\n"]
[13.79, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mPerformance Insights records query-level activity over time — the evidence needed to spot anomalous access patterns and analyse database incidents under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n"]
[13.9, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable Performance Insights on the instance:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_db_instance\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"main\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    performance_insights_enabled = true\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n"]
[14.01, "o", "\u001b[1;36mFile: \u001b[0m\u001b[1;36m/\u001b[0m\u001b[1;36ms3.tf\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV2_AWS_6\u001b[0m: Ensure that S3 bucket has a Public Access block\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n"]
[14.12, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mA bucket with no aws_s3_bucket_public_access_block has no safety net against accidental public exposure via ACLs or bucket policy - a standing confidentiality risk for any personal data under GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[14.23, "o", "      \u001b[2mAttach a public access block that denies all public access \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2msee CKV_AWS_53 for the\u001b[0m\n      \u001b[2mfull resource\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m; at minimum:\u001b[0m\n      \u001b[2m  block_public_acls       = true\u001b[0m\n      \u001b[2m  block_public_policy     = true\u001b[0m\n      \u001b[2m  ignore_public_acls      = true\u001b[0m\n      \u001b[2m  restrict_public_buckets = true\u001b[0m\n"]
[14.34, "o", "\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_53\u001b[0m: Ensure S3 bucket has block public ACLS enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket_public_access_block.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m12\u001b[0m-\u001b[1;36m19\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n"]
[14.45, "o", "\n    \u001b[3mWith block_public_acls disabled, a future ACL change can silently make objects public, weakening the confidentiality control GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires. The public access block is the account-level guardrail that prevents that drift.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable the guardrail on the bucket's public access block:\u001b[0m\n"]
[14.56, "o", "      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_public_access_block\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket                  = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    block_public_acls       = true\u001b[0m\n      \u001b[2m    ignore_public_acls      = true\u001b[0m\n      \u001b[2m    block_public_policy     = true\u001b[0m\n      \u001b[2m    restrict_public_buckets = true\u001b[0m\n"]
[14.67, "o", "      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_54\u001b[0m: Ensure S3 bucket has block public policy enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket_public_access_block.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m12\u001b[0m-\u001b[1;36m19\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n"]
[14.78, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWith block_public_policy disabled, a bucket policy can grant anonymous access to objects, silently exposing personal data. It is the policy-side counterpart to CKV_AWS_53 and a direct confidentiality risk under GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[14.89, "o", "      \u001b[2mEnable the guardrail on the bucket's public access block:\u001b[0m\n      \u001b[2m  block_public_policy = true\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_55\u001b[0m: Ensure S3 bucket has ignore public ACLs enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket_public_access_block.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m12\u001b[0m-\u001b[1;36m19\u001b[0m\n"]
[15.0, "o", "    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWith ignore_public_acls disabled, public ACLs applied to the bucket or its objects are honoured rather than neutralised, allowing anonymous read/write and undermining the confidentiality control of GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n"]
[15.11, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable the guardrail on the bucket's public access block:\u001b[0m\n      \u001b[2m  ignore_public_acls = true\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV_AWS_56\u001b[0m: Ensure S3 bucket has \u001b[32m'restrict_public_buckets'\u001b[0m enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket_public_access_block.data\n"]
[15.22, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m12\u001b[0m-\u001b[1;36m19\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWith restrict_public_buckets disabled, a public bucket policy grants access to all principals and anonymous users rather than only authorised AWS services and users, widening exposure of personal data which may weaken GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n"]
[15.33, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable the guardrail on the bucket's public access block:\u001b[0m\n      \u001b[2m  restrict_public_buckets = true\u001b[0m\n\n  \u001b[31m●\u001b[0m \u001b[1mCKV2_AWS_6\u001b[0m: Ensure that S3 bucket has a Public Access block\n"]
[15.44, "o", "    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[31mHIGH\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mA bucket with no aws_s3_bucket_public_access_block has no safety net against accidental public exposure via ACLs or bucket policy - a standing confidentiality risk for any personal data under GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n"]
[15.55, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mAttach a public access block that denies all public access \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2msee CKV_AWS_53 for the\u001b[0m\n      \u001b[2mfull resource\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m; at minimum:\u001b[0m\n      \u001b[2m  block_public_acls       = true\u001b[0m\n"]
[15.66, "o", "      \u001b[2m  block_public_policy     = true\u001b[0m\n      \u001b[2m  ignore_public_acls      = true\u001b[0m\n      \u001b[2m  restrict_public_buckets = true\u001b[0m\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_144\u001b[0m: Ensure that S3 bucket has cross-region replication enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n"]
[15.77, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n    \u001b[3mA bucket replicated only in one region is lost with that region. Cross-region replication is the mechanism that keeps personal data available and restorable after a regional outage, relevant to NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n"]
[15.88, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mReplicate the bucket to another region permitted by the configured\u001b[0m\n      \u001b[2mresidency policy \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2man in-policy region, when available\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_replication_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"data\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    role   = aws_iam_role.replication.arn\u001b[0m\n"]
[15.99, "o", "      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    rule \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m destination \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m bucket = aws_s3_bucket.replica.arn \u001b[0m\u001b[1;2m}\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_145\u001b[0m: Ensure that S3 buckets are encrypted with KMS by default\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n"]
[16.1, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0ma\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mh\u001b[1m)\u001b[0m\n\n    \u001b[3mNew objects in a bucket without default SSE-KMS are already encrypted at rest with S3-managed keys \u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mSSE-S3\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m. A KMS key adds key-policy, rotation and access-grant control over that data, which can support demonstrating NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mh\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3ma\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m for buckets that hold personal data.\u001b[0m\n\n"]
[16.21, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mConfigure default SSE-KMS on the bucket:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_server_side_encryption_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    rule \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[16.32, "o", "      \u001b[2m      apply_server_side_encryption_by_default \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m        sse_algorithm     = \u001b[0m\u001b[2;32m\"aws:kms\"\u001b[0m\n      \u001b[2m        kms_master_key_id = aws_kms_key.s3.arn\u001b[0m\n      \u001b[2m      \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[16.43, "o", "\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_18\u001b[0m: Ensure the S3 bucket has access logging enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n"]
[16.54, "o", "\n    \u001b[3mWithout S3 server access logging there is no record of who read or wrote objects, so a data-access incident cannot be detected, scoped, or investigated. NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires the ability to handle and analyse incidents.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mSend access logs to a dedicated logging bucket:\u001b[0m\n"]
[16.65, "o", "      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_logging\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket        = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    target_bucket = aws_s3_bucket.logs.id\u001b[0m\n      \u001b[2m    target_prefix = \u001b[0m\u001b[2;32m\"s3-access/\"\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n"]
[16.76, "o", "  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_21\u001b[0m: Ensure all data stored in the S3 bucket have versioning enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n"]
[16.87, "o", "    \u001b[3mWithout versioning, an accidental or malicious overwrite/delete is unrecoverable. Versioning provides point-in-time restore, supporting the recovery obligation in GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and business continuity under NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable bucket versioning:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_versioning\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[16.98, "o", "      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    versioning_configuration \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m status = \u001b[0m\u001b[2;32m\"Enabled\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_144\u001b[0m: Ensure that S3 bucket has cross-region replication enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n"]
[17.09, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n    \u001b[3mA bucket replicated only in one region is lost with that region. Cross-region replication is the mechanism that keeps personal data available and restorable after a regional outage, relevant to NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n"]
[17.2, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mReplicate the bucket to another region permitted by the configured\u001b[0m\n      \u001b[2mresidency policy \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2man in-policy region, when available\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_replication_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"data\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    role   = aws_iam_role.replication.arn\u001b[0m\n"]
