[18.865, "o", "      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430357;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-that-s3-buckets-are-encrypted-with-kms-by-default\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_144\u001b[0m: Ensure that S3 bucket has cross-region replication enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n"]
[18.975, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n    \u001b[3mA bucket replicated only in one region is lost with that region. Cross-region replication is the mechanism\u001b[0m\n\u001b[3mthat keeps personal data available and restorable after a regional outage, as NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and GDPR Art.\u001b[0m\n"]
[19.085, "o", "\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m require.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mReplicate the bucket to a second region:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_replication_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"data\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[19.195, "o", "      \u001b[2m    role   = aws_iam_role.replication.arn\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    rule \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m destination \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m bucket = aws_s3_bucket.replica.arn \u001b[0m\u001b[1;2m}\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430360;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-that-s3-bucket-has-cross-region-replication-enabled\u001b\\→ Documentation\u001b]8;;\u001b\\\n"]
[19.305, "o", "\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_144\u001b[0m: Ensure that S3 bucket has cross-region replication enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n"]
[19.415, "o", "\n    \u001b[3mA bucket replicated only in one region is lost with that region. Cross-region replication is the mechanism\u001b[0m\n\u001b[3mthat keeps personal data available and restorable after a regional outage, as NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and GDPR Art.\u001b[0m\n\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m require.\u001b[0m\n\n\n"]
[19.525, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mReplicate the bucket to a second region:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_replication_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"data\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    role   = aws_iam_role.replication.arn\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    rule \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m destination \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m bucket = aws_s3_bucket.replica.arn \u001b[0m\u001b[1;2m}\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[19.635, "o", "      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430362;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-that-s3-bucket-has-cross-region-replication-enabled\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_21\u001b[0m: Ensure all data stored in the S3 bucket have versioning enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n"]
[19.745, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout versioning, an accidental or malicious overwrite/delete is unrecoverable. Versioning provides \u001b[0m\n\u001b[3mpoint-in-time restore, supporting the recovery obligation in GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and business continuity under \u001b[0m\n"]
[19.855, "o", "\u001b[3mNIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mEnable bucket versioning:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_versioning\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n"]
[19.965, "o", "      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    versioning_configuration \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m status = \u001b[0m\u001b[2;32m\"Enabled\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430365;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/s3-16-enable-versioning\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n"]
[20.075, "o", "  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_21\u001b[0m: Ensure all data stored in the S3 bucket have versioning enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m, \u001b[1mGDPR\u001b[0m Art. \u001b[1;35m32\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n"]
[20.185, "o", "    \u001b[3mWithout versioning, an accidental or malicious overwrite/delete is unrecoverable. Versioning provides \u001b[0m\n\u001b[3mpoint-in-time restore, supporting the recovery obligation in GDPR Art. \u001b[0m\u001b[1;3;35m32\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m1\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m and business continuity under \u001b[0m\n\u001b[3mNIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[20.295, "o", "      \u001b[2mEnable bucket versioning:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_versioning\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    versioning_configuration \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m status = \u001b[0m\u001b[2;32m\"Enabled\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n"]
[20.405, "o", "    \u001b]8;id=13430367;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/s3-16-enable-versioning\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_18\u001b[0m: Ensure the S3 bucket has access logging enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n"]
[20.515, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout S3 server access logging there is no record of who read or wrote objects, so a data-access \u001b[0m\n\u001b[3mincident cannot be detected, scoped, or investigated. NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires the ability to handle and \u001b[0m\n\u001b[3manalyse incidents.\u001b[0m\n\n"]
[20.625, "o", "\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mSend access logs to a dedicated logging bucket:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_logging\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket        = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    target_bucket = aws_s3_bucket.logs.id\u001b[0m\n"]
[20.735, "o", "      \u001b[2m    target_prefix = \u001b[0m\u001b[2;32m\"s3-access/\"\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430370;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/s3-13-enable-logging\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[33m●\u001b[0m \u001b[1mCKV_AWS_18\u001b[0m: Ensure the S3 bucket has access logging enabled\n"]
[20.845, "o", "    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[33mMEDIUM\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout S3 server access logging there is no record of who read or wrote objects, so a data-access \u001b[0m\n"]
[20.955, "o", "\u001b[3mincident cannot be detected, scoped, or investigated. NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires the ability to handle and \u001b[0m\n\u001b[3manalyse incidents.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mSend access logs to a dedicated logging bucket:\u001b[0m\n"]
[21.065, "o", "      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_logging\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"this\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket        = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    target_bucket = aws_s3_bucket.logs.id\u001b[0m\n      \u001b[2m    target_prefix = \u001b[0m\u001b[2;32m\"s3-access/\"\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n"]
[21.175, "o", "    \u001b]8;id=13430372;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/s3-13-enable-logging\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_62\u001b[0m: Ensure S3 buckets should have event notifications enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n"]
[21.285, "o", "    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout event notifications, writes to a bucket holding personal data raise no signal — unexpected mass \u001b[0m\n\u001b[3mdownloads or deletions go unnoticed instead of feeding the detection capability NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires.\u001b[0m\n\n\n"]
[21.395, "o", "    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mSubscribe at least one notification target to bucket events:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_notification\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"data\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n      \u001b[2m    lambda_function \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m lambda_function_arn = aws_lambda_function.auditor.arn\u001b[0m\n      \u001b[2m                      events = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"s3:ObjectCreated:*\"\u001b[0m\u001b[1;2m]\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n"]
[21.505, "o", "      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430375;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-logging-policies/bc-aws-2-62\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_62\u001b[0m: Ensure S3 buckets should have event notifications enabled\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n"]
[21.615, "o", "    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mb\u001b[1m)\u001b[0m\n\n    \u001b[3mWithout event notifications, writes to a bucket holding personal data raise no signal — unexpected mass \u001b[0m\n\u001b[3mdownloads or deletions go unnoticed instead of feeding the detection capability NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mb\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m requires.\u001b[0m\n"]
[21.725, "o", "\n\n    \u001b[1mRemediation:\u001b[0m\n      \u001b[2mSubscribe at least one notification target to bucket events:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_notification\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"data\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.data.id\u001b[0m\n"]
[21.835, "o", "      \u001b[2m    lambda_function \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m lambda_function_arn = aws_lambda_function.auditor.arn\u001b[0m\n      \u001b[2m                      events = \u001b[0m\u001b[1;2m[\u001b[0m\u001b[2;32m\"s3:ObjectCreated:*\"\u001b[0m\u001b[1;2m]\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430377;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-logging-policies/bc-aws-2-62\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n"]
[21.945, "o", "  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_61\u001b[0m: Ensure that an S3 bucket has a lifecycle configuration\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.data\n    \u001b[2mLines:\u001b[0m \u001b[1;36m2\u001b[0m-\u001b[1;36m9\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n"]
[22.055, "o", "    \u001b[3mWithout lifecycle rules, log and backup objects accumulate indefinitely or are manually purged ad hoc, so \u001b[0m\n\u001b[3mretention for data protection and continuity purposes is unmanaged. Lifecycle configuration is the disciplined\u001b[0m\n\u001b[3mdata lifecycle NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m backup management expects.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[22.165, "o", "      \u001b[2mDefine lifecycle rules \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mtransition + expiry\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m for the bucket:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_lifecycle_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"logs\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.logs.id\u001b[0m\n      \u001b[2m    rule \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m      id     = \u001b[0m\u001b[2;32m\"expire-logs\"\u001b[0m\n      \u001b[2m      status = \u001b[0m\u001b[2;32m\"Enabled\"\u001b[0m\n"]
[22.275, "o", "      \u001b[2m      expiration \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m days = \u001b[0m\u001b[1;2;36m365\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430380;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-logging-policies/bc-aws-2-61\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n"]
[22.385, "o", "  \u001b[34m●\u001b[0m \u001b[1mCKV2_AWS_61\u001b[0m: Ensure that an S3 bucket has a lifecycle configuration\n    \u001b[2mResource:\u001b[0m aws_s3_bucket.logs\n    \u001b[2mLines:\u001b[0m \u001b[1;36m22\u001b[0m-\u001b[1;36m28\u001b[0m\n    \u001b[2mSeverity:\u001b[0m \u001b[34mLOW\u001b[0m\n    \u001b[2mCompliance:\u001b[0m \u001b[1mNIS2\u001b[0m Art. \u001b[1;35m21\u001b[0m\u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\u001b[1m(\u001b[0mc\u001b[1m)\u001b[0m\n\n"]
[22.495, "o", "    \u001b[3mWithout lifecycle rules, log and backup objects accumulate indefinitely or are manually purged ad hoc, so \u001b[0m\n\u001b[3mretention for data protection and continuity purposes is unmanaged. Lifecycle configuration is the disciplined\u001b[0m\n\u001b[3mdata lifecycle NIS2 Art. \u001b[0m\u001b[1;3;35m21\u001b[0m\u001b[1;3m(\u001b[0m\u001b[1;3;36m2\u001b[0m\u001b[1;3m)\u001b[0m\u001b[1;3m(\u001b[0m\u001b[3mc\u001b[0m\u001b[1;3m)\u001b[0m\u001b[3m backup management expects.\u001b[0m\n\n\n    \u001b[1mRemediation:\u001b[0m\n"]
[22.605, "o", "      \u001b[2mDefine lifecycle rules \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mtransition + expiry\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m for the bucket:\u001b[0m\n      \u001b[2m  resource \u001b[0m\u001b[2;32m\"aws_s3_bucket_lifecycle_configuration\"\u001b[0m\u001b[2m \u001b[0m\u001b[2;32m\"logs\"\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m    bucket = aws_s3_bucket.logs.id\u001b[0m\n      \u001b[2m    rule \u001b[0m\u001b[1;2m{\u001b[0m\n      \u001b[2m      id     = \u001b[0m\u001b[2;32m\"expire-logs\"\u001b[0m\n      \u001b[2m      status = \u001b[0m\u001b[2;32m\"Enabled\"\u001b[0m\n"]
[22.715, "o", "      \u001b[2m      expiration \u001b[0m\u001b[1;2m{\u001b[0m\u001b[2m days = \u001b[0m\u001b[1;2;36m365\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m    \u001b[0m\u001b[1;2m}\u001b[0m\n      \u001b[2m  \u001b[0m\u001b[1;2m}\u001b[0m\n\n    \u001b]8;id=13430382;https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-logging-policies/bc-aws-2-61\u001b\\→ Documentation\u001b]8;;\u001b\\\n\n"]
[22.785, "o", "\u001b[1m═══════════════════════════════════════════════════\u001b[0m\n\n"]
