#!/usr/bin/env bash
# Local quality gate. Runs the same checks as the CI lint job (ruff check,
# ruff format --check, mypy) and does not modify files or run the test suite.
# The development environment is created only when it is missing.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

VENV_DIR="${UV_PROJECT_ENVIRONMENT:-.venv}"

# POSIX venvs use bin/, Windows venvs (Git Bash) use Scripts/.
find_venv_python() {
  if [ -x "$VENV_DIR/Scripts/python.exe" ]; then
    echo "$VENV_DIR/Scripts/python.exe"
  elif [ -x "$VENV_DIR/bin/python" ]; then
    echo "$VENV_DIR/bin/python"
  fi
}

VENV_PYTHON="$(find_venv_python)"

if [ -z "$VENV_PYTHON" ]; then
  if ! command -v uv >/dev/null 2>&1; then
    echo "pre-commit: $VENV_DIR is missing and uv is not installed; install uv and retry" >&2
    exit 1
  fi
  echo "pre-commit: creating $VENV_DIR with Python 3.11+ via uv"
  uv venv --python 3.11 "$VENV_DIR"
  VENV_PYTHON="$(find_venv_python)"
  echo "pre-commit: installing project development tools via uv"
  uv pip install --python "$VENV_PYTHON" -e ".[dev]"
fi

status=0

run_check() {
  local name="$1"
  shift
  echo "pre-commit: running $name"
  if ! "$@"; then
    status=1
  fi
}

# Keep these commands identical to the lint job in .github/workflows/ci.yml.
run_check ruff "$VENV_PYTHON" -m ruff check .
run_check "ruff format --check" "$VENV_PYTHON" -m ruff format --check .
run_check mypy "$VENV_PYTHON" -m mypy --ignore-missing-imports tf_eu_guard tools

exit "$status"
